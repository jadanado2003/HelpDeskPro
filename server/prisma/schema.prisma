generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TECHNICIAN
  REQUESTER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  ACCOUNT_ACCESS
  SECURITY
  OTHER
}

enum AssetType {
  LAPTOP
  DESKTOP
  MONITOR
  PHONE
  TABLET
  PRINTER
  ROUTER
  SWITCH
  ACCESS_POINT
  SERVER
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  RETIRED
  LOST
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum TicketActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  COMMENT_ADDED
  ASSET_LINKED
  RESOLVED
  CLOSED
  REOPENED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(REQUESTER)
  department   String?
  jobTitle     String?
  isActive     Boolean  @default(true)

  ticketsRequested Ticket[]         @relation("TicketRequester")
  ticketsAssigned  Ticket[]         @relation("TicketTechnician")
  comments         TicketComment[]  @relation("CommentAuthor")
  activities       TicketActivity[] @relation("ActivityActor")
  assetsAssigned   Asset[]          @relation("AssetAssignedUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([fullName])
  @@index([email])
}

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  title        String
  description  String
  category     TicketCategory
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)

  requesterId String
  requester   User @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)

  technicianId String?
  technician   User? @relation("TicketTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  dueAt      DateTime?
  resolvedAt DateTime?
  closedAt   DateTime?

  comments   TicketComment[]
  activities TicketActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([requesterId])
  @@index([technicianId])
  @@index([assetId])
  @@index([createdAt])
}

model TicketComment {
  id         String  @id @default(cuid())
  body       String
  isInternal Boolean @default(false)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([authorId])
}

model TicketActivity {
  id      String             @id @default(cuid())
  type    TicketActivityType
  message String

  previousStatus   TicketStatus?
  newStatus        TicketStatus?
  previousPriority TicketPriority?
  newPriority      TicketPriority?

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
}

model Asset {
  id                 String         @id @default(cuid())
  assetTag           String         @unique
  name               String
  type               AssetType
  serialNumber       String?        @unique
  status             AssetStatus    @default(AVAILABLE)
  condition          AssetCondition @default(GOOD)
  location           String?
  purchaseDate       DateTime?
  warrantyExpiryDate DateTime?
  notes              String?

  assignedUserId String?
  assignedUser   User? @relation("AssetAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetTag])
  @@index([type])
  @@index([status])
  @@index([assignedUserId])
  @@index([warrantyExpiryDate])
}